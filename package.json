{
  "name": "termdeck",
  "displayName": "TermDeck",
  "description": "%description%",
  "l10n": "./l10n",
  "version": "0.0.3",
  "icon": "media/icon.png",
  "publisher": "casper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wcc723/switchboard-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Wcc723/switchboard-vscode/issues"
  },
  "homepage": "https://github.com/Wcc723/switchboard-vscode#readme",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "claude",
    "codex",
    "project",
    "multi-root",
    "session manager"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:projectSwitch.projects",
    "onView:projectSwitch.files"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectSwitch",
          "title": "TermDeck",
          "icon": "media/projects.svg"
        }
      ]
    },
    "views": {
      "projectSwitch": [
        {
          "id": "projectSwitch.projects",
          "name": "%view.projects.name%",
          "type": "webview"
        },
        {
          "id": "projectSwitch.files",
          "name": "%view.files.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "projectSwitch.files",
        "contents": "%welcome.files%"
      }
    ],
    "commands": [
      {
        "command": "projectSwitch.addProject",
        "title": "%command.addProject.title%",
        "category": "TermDeck",
        "icon": "$(add)"
      },
      {
        "command": "projectSwitch.refresh",
        "title": "%command.refresh.title%",
        "category": "TermDeck",
        "icon": "$(refresh)"
      },
      {
        "command": "projectSwitch.newSession",
        "title": "%command.newSession.title%",
        "category": "TermDeck",
        "icon": "$(add)"
      },
      {
        "command": "projectSwitch.openTerminalHere",
        "title": "%command.openTerminalHere.title%",
        "category": "TermDeck",
        "icon": "$(terminal)"
      },
      {
        "command": "projectSwitch.setColor",
        "title": "%command.setColor.title%",
        "category": "TermDeck",
        "icon": "$(symbol-color)"
      },
      {
        "command": "projectSwitch.renameProject",
        "title": "%command.renameProject.title%",
        "category": "TermDeck"
      },
      {
        "command": "projectSwitch.removeProject",
        "title": "%command.removeProject.title%",
        "category": "TermDeck"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "projectSwitch.addProject",
          "when": "view == projectSwitch.projects",
          "group": "navigation@1"
        },
        {
          "command": "projectSwitch.refresh",
          "when": "view == projectSwitch.files",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "projectSwitch.openTerminalHere",
          "when": "view == projectSwitch.files && viewItem == folder",
          "group": "inline@0"
        }
      ]
    },
    "configuration": {
      "title": "TermDeck",
      "properties": {
        "projectSwitch.onProjectClick": {
          "type": "string",
          "enum": [
            "focusOrStartSession",
            "focusOnly",
            "alwaysNewSession"
          ],
          "enumDescriptions": [
            "%config.onProjectClick.focusOrStartSession%",
            "%config.onProjectClick.focusOnly%",
            "%config.onProjectClick.alwaysNewSession%"
          ],
          "default": "focusOrStartSession",
          "description": "%config.onProjectClick.description%"
        },
        "projectSwitch.addToWorkspace": {
          "type": "boolean",
          "default": false,
          "description": "%config.addToWorkspace.description%"
        },
        "projectSwitch.autoStartClaude": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoStartClaude.description%"
        },
        "projectSwitch.claudeCommand": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "markdownDescription": "%config.claudeCommand.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.93.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
