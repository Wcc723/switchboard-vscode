{
  "name": "project-switch",
  "displayName": "Project Switch",
  "description": "單一視窗管理多個專案與多個 Claude Code session 的駕駛艙",
  "version": "0.0.1",
  "publisher": "casper",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:projectSwitch.projects",
    "onView:projectSwitch.files"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectSwitch",
          "title": "Projects",
          "icon": "media/projects.svg"
        }
      ]
    },
    "views": {
      "projectSwitch": [
        {
          "id": "projectSwitch.projects",
          "name": "Projects",
          "type": "webview"
        },
        {
          "id": "projectSwitch.files",
          "name": "Files"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "projectSwitch.files",
        "contents": "從上方 Projects 選一個專案，即可在此瀏覽它的檔案。"
      }
    ],
    "commands": [
      {
        "command": "projectSwitch.addProject",
        "title": "新增專案",
        "category": "Project Switch",
        "icon": "$(add)"
      },
      {
        "command": "projectSwitch.refresh",
        "title": "重新整理",
        "category": "Project Switch",
        "icon": "$(refresh)"
      },
      {
        "command": "projectSwitch.newSession",
        "title": "開新 terminal",
        "category": "Project Switch",
        "icon": "$(add)"
      },
      {
        "command": "projectSwitch.openTerminalHere",
        "title": "在此資料夾開 terminal",
        "category": "Project Switch",
        "icon": "$(terminal)"
      },
      {
        "command": "projectSwitch.setColor",
        "title": "設定專案顏色",
        "category": "Project Switch",
        "icon": "$(symbol-color)"
      },
      {
        "command": "projectSwitch.renameProject",
        "title": "重新命名專案",
        "category": "Project Switch"
      },
      {
        "command": "projectSwitch.removeProject",
        "title": "移除專案",
        "category": "Project Switch"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "projectSwitch.addProject",
          "when": "view == projectSwitch.projects",
          "group": "navigation@1"
        },
        {
          "command": "projectSwitch.refresh",
          "when": "view == projectSwitch.files",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "projectSwitch.openTerminalHere",
          "when": "view == projectSwitch.files && viewItem == folder",
          "group": "inline@0"
        }
      ]
    },
    "configuration": {
      "title": "Project Switch",
      "properties": {
        "projectSwitch.onProjectClick": {
          "type": "string",
          "enum": [
            "focusOrStartSession",
            "focusOnly",
            "alwaysNewSession"
          ],
          "enumDescriptions": [
            "聚焦既有 terminal，沒有就開一個新的",
            "只聚焦既有 terminal（不自動開新的）",
            "每次點都開一個新 terminal"
          ],
          "default": "focusOrStartSession",
          "description": "在面板點專案時的行為。"
        },
        "projectSwitch.autoStartClaude": {
          "type": "boolean",
          "default": false,
          "description": "開 terminal 時是否自動執行 Claude 指令。預設關閉，只開一個乾淨的 terminal；開啟則會自動跑下方的指令。"
        },
        "projectSwitch.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "啟動 Claude Code 的指令，可改為 'claude --resume' 等。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.93.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
